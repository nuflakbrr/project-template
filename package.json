{
  "name": "bikinproject",
  "version": "2.0.0",
  "private": true,
  "description": "A modern CLI tool to generate type-safe TypeScript project with best practices and customizable configurations",
  "keywords": [
    "bikinproject",
    "bikinproject-app",
    "biome",
    "boilerplate",
    "cli",
    "drizzle",
    "fullstack",
    "hono",
    "monorepo",
    "prisma",
    "project generator",
    "pwa",
    "react",
    "shadcn",
    "starter",
    "starter project",
    "tailwind",
    "tanstack",
    "trpc",
    "turborepo",
    "type-safety",
    "typescript"
  ],
  "homepage": "https://nuflakbrr.github.io/bikinproject/",
  "bugs": {
    "url": "https://github.com/nuflakbrr/bikinproject/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Naufal Akbar Nugroho",
    "email": "naufalakbar378@gmail.com",
    "url": "https://github.com/nuflakbrr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuflakbrr/bikinproject.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cli": "turbo run dev --filter=create-bikinproject-app --filter=@bikinproject/template-generator --filter=create-bpa",
    "cli": "cd apps/cli && node dist/cli.js",
    "dev:web": "turbo run dev --filter=web",
    "build:web": "turbo run build --filter=web",
    "build:cli": "turbo run build --filter=create-bikinproject-app",
    "lint": "turbo run lint",
    "check": "oxfmt . && oxlint .",
    "prepare": "lefthook install",
    "release": "bun run scripts/release.ts",
    "bump": "bun run scripts/bump-version.ts",
    "canary": "bun run scripts/canary-release.ts",
    "cleanup-previews": "bun run scripts/cleanup-previews.ts",
    "deploy:convex": "turbo run --filter=@bikinproject/backend deploy",
    "deploy:web": "turbo run deploy --filter=web",
    "generate": "turbo run generate-schema --filter=web",
    "deploy": "turbo run deploy --filter=web"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.15.3",
    "changelogithub": "^14.0.0",
    "lefthook": "^2.1.2",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "turbo": "^2.8.13",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*": [
      "bun check"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.20"
}
