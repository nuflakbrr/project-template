{
  "name": "@bikinproject/types",
  "version": "1.0.0",
  "description": "TypeScript types and schemas for create-bikinproject-app CLI",
  "keywords": [
    "bikinproject",
    "cli",
    "schemas",
    "types",
    "typescript"
  ],
  "homepage": "https://nuflakbrr.github.io/bikinproject/",
  "license": "MIT",
  "author": {
    "name": "Naufal Akbar Nugroho",
    "email": "naufalakbar378@gmail.com",
    "url": "https://github.com/nuflakbrr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuflakbrr/bikinproject.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.mts",
      "default": "./dist/json-schema.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsdown": "^0.17.2",
    "typescript": "^5.9.3"
  }
}
